# doc-tester configuration. Copy this file to .env and fill it in; .env is git-ignored.
#
# There are three kinds of value below, and which kind you are looking at decides how to fill it:
#
#   MUST BE REAL   a Console account, and project members whose table rows a plan acts on. A run
#                  signs in for real and sends real invitations, so these cannot be invented.
#   LOOK IT UP     the standing project and service ids — `tiger service list`.
#   YOUR CHOICE    passwords for roles a run creates on a throwaway fork and then destroys. Generate
#                  something random; nothing outside this file ever needs to know it. For example:
#                    openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c 28; echo


# ---- MUST BE REAL — Console sign-in for the UI walk (npm run login) ------------------------------
# Login runs headlessly: no browser window, works in CI. Store these as CI secrets. Prefer an
# account made for automation over your own, since a run acts on every project it can see.
CONSOLE_EMAIL=your-email@example.com
CONSOLE_PASSWORD=your-console-password


# ---- LOOK IT UP — the standing test project, and one standing service per cloud ------------------
# `tiger auth login`, select the project that hosts them, then read the ids from `tiger service list`.
# A run drives these directly for read-only steps and forks one of them for anything destructive, so
# the standing services are never mutated. Keep them in an Enterprise-plan project so that
# plan-gated procedures can be forked and exercised for real.
#
# These are recreated periodically and THE IDS CHANGE. Nothing in git names a service: a missing
# value throws on import rather than pointing a run at an id that used to be right. A stale id fails
# on `tiger service get` before the browser starts, and the error names this file.
DOCTEST_PROJECT_ID=
DOCTEST_SERVICE_AWS=
DOCTEST_SERVICE_AZURE=


# ---- Plan inputs --------------------------------------------------------------------------------
# A page's <TestPlan> must never contain a real address or credential, because plans live in a public
# docs repo. A plan names a value instead — `type $INVITE_EMAIL into `Type the email``, or
# '$POOLER_PASSWORD' inside a SQL statement — and the run resolves $NAME from DOCTEST_INPUT_<NAME>
# here. The mechanism is generic: any $NAME works and there is no per-name code, so add a key when a
# new plan names one. A run that cannot resolve a name reports that step blocked and prints the
# variable to set, rather than running with the literal text.
#
# What needs what, as of now (grep the plans if in doubt):
#   _security-members.mdx          INVITE_EMAIL, ROLE_EMAIL
#   _security-ip-allow-list.mdx    IP_CIDR
#   _connection-pooling.mdx        POOLER_PASSWORD
#   _security-read-only-role.mdx   READ_USER_PASSWORD

# MUST BE REAL: inviting a member sends an actual email, so use an address you can open. A +alias on
# the account the tool signs in as works and keeps the invite out of a person's inbox.
DOCTEST_INPUT_INVITE_EMAIL=an-address-you-control@example.com

# MUST BE REAL: an existing non-owner member of the project who has ACCEPTED their invitation. The
# members plan changes this person's role and puts it back. A pending invite will not do — its role
# renders as plain text with no drop-down, so the documented procedure has no control to press.
DOCTEST_INPUT_ROLE_EMAIL=a-test-member@example.com

# MUST BE REAL: the account the tool signs in as, so the same address as CONSOLE_EMAIL above. Used by
# steps that act on your OWN member row, such as leaving a project.
DOCTEST_INPUT_OWNER_EMAIL=the-console-account@example.com

# Leave this alone unless you have a reason to change it. RFC 5737 reserves 203.0.113.0/24 for
# documentation, so it is not routable and an allow list built from it cannot restrict access to
# anything real. The prefix drop-down keeps its default of /24.
DOCTEST_INPUT_IP_CIDR=203.0.113.0

# YOUR CHOICE: the password for the pooler role the connection-pooling plan creates on a throwaway
# fork, then connects as through the pooler. Generate a random one.
DOCTEST_INPUT_POOLER_PASSWORD=

# YOUR CHOICE: the password for the read-only login role the read-only-role plan creates on a
# throwaway fork. The page itself prints <PASSWORD>, as it should — a published password on a
# login-capable role is one a reader would paste verbatim — so the value has to come from here.
DOCTEST_INPUT_READ_USER_PASSWORD=


# ---- LOOK IT UP — the EC2 self-hosted TimescaleDB target -----------------------------------------
# `infra/` provisions a throwaway EC2 instance with TimescaleDB pre-installed, reachable only via an
# SSM Session Manager port-forward (no public inbound ports — see docs/adr/0002). Nothing here is a
# secret: the DB password is Terraform-generated and stored in SSM Parameter Store, never here.
#
# DOCTEST_AWS_PROFILE must match the local AWS CLI profile for the docs-tester IAM user (see
# docs/adr/0003). DOCTEST_EC2_LOCAL_PORT is the local end of the tunnel infra/tunnel.sh opens; pick
# anything free, it never needs to match Postgres's own port on the instance.
DOCTEST_AWS_PROFILE=docs-tester

# LOOK IT UP: the S3 bucket that holds the Terraform state and the EC2 slot lease. Its name contains
# the AWS account number, so it lives here and not in git. Read it from
# the account: `aws s3 ls --profile docs-tester | grep tfstate`. A missing value throws on import.
DOCTEST_TFSTATE_BUCKET=
DOCTEST_EC2_LOCAL_PORT=55432
